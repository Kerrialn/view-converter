#!/usr/bin/env php
<?php

use ViewConverter\Command\JqueryConverterCommand;
use ViewConverter\Command\StimulusConverterCommand;
use ViewConverter\Command\ViewConverterCommand;
use ViewConverter\Command\VueConverterCommand;
use Symfony\Component\Console\Application;

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadPaths as $path) {
    if (!file_exists($path)) {
        continue;
    }

    require $path;
    break;
}

if (!class_exists(ViewConverterCommand::class)) {
    fwrite(STDERR, "Autoload failed. Did you run `composer install`?\n");
    exit(1);
}

$application = new Application();
$application->add(new ViewConverterCommand());
$application->add(new StimulusConverterCommand());
$application->add(new JqueryConverterCommand());
$application->add(new VueConverterCommand());
$application->run();